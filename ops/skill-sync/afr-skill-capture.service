[Unit]
Description=Capture verified AFR Drive drafts without modifying authoring files
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/
ExecStart=/usr/bin/python3 %h/.local/lib/afr-skill-sync/skill_sync.py --config %h/.config/afr-skill-sync/working.json capture
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
TimeoutStartSec=180
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/afr-skill-sync %h/.config/rclone
LockPersonality=true
RestrictSUIDSGID=true
